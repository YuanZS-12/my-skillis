{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "nx-cad NXOpen API recipe",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "nx_version",
    "status",
    "api_family",
    "required_imports",
    "required_api_objects",
    "fixture",
    "runtime_result"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "minLength": 1},
    "nx_version": {"type": "string", "minLength": 1},
    "status": {"enum": ["experimental", "verified", "rejected"]},
    "api_family": {"type": "string", "minLength": 1},
    "required_imports": {"type": "array", "items": {"type": "string"}},
    "required_api_objects": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "fixture": {"type": ["string", "null"]},
    "runtime_result": {"type": ["string", "null"]},
    "known_incompatibilities": {"type": "array", "items": {"type": "string"}}
  }
}
