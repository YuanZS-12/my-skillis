#!/usr/bin/env python3
"""Create an MCP-reviewed workspace Journal for a manual NX UI run."""

from __future__ import annotations

import argparse
import ast
import io
import json
import shutil
import tokenize
from pathlib import Path


SKILL_ROOT = Path(__file__).resolve().parents[1]
ALLOWED_REVIEW_TOOLS = {
    "dc_lookup_pattern",
    "dc_search",
    "dc_semantic_search",
    "dc_get_api_info",
    "dc_list_namespace",
}


def assignment(tree: ast.Module, names: set[str]) -> ast.Assign | ast.AnnAssign | None:
    for node in tree.body:
        if not isinstance(node, (ast.Assign, ast.AnnAssign)):
            continue
        targets = node.targets if isinstance(node, ast.Assign) else [node.target]
        if any(isinstance(target, ast.Name) and target.id in names for target in targets):
            return node
    return None


def assignment_end_lineno(source: str, node: ast.Assign | ast.AnnAssign) -> int:
    """Return the logical assignment end line on Python 3.7 and newer."""
    end_lineno = getattr(node, "end_lineno", None)
    if isinstance(end_lineno, int):
        return end_lineno
    try:
        tokens = tokenize.generate_tokens(io.StringIO(source).readline)
        for token in tokens:
            if token.start[0] < node.lineno:
                continue
            if token.type == tokenize.NEWLINE:
                return token.end[0]
    except (IndentationError, SyntaxError, tokenize.TokenError):
        pass
    return node.lineno


def replace_assignment(source: str, node: ast.Assign | ast.AnnAssign, replacement: str) -> str:
    lines = source.splitlines(keepends=True)
    start = node.lineno - 1
    end = assignment_end_lineno(source, node)
    newline = "\r\n" if lines[start].endswith("\r\n") else "\n"
    lines[start:end] = [replacement + newline]
    return "".join(lines)


def unlink_if_present(path: Path) -> None:
    """Remove a path if present without relying on the Python 3.8 keyword."""
    try:
        path.unlink()
    except FileNotFoundError:
        pass


def copy_support_file(source: Path, output: Path) -> None:
    if not source.is_file():
        raise ValueError(f"Journal support is missing: {source}")
    if output.exists():
        try:
            matches = output.is_file() and output.read_bytes() == source.read_bytes()
        except OSError as exc:
            raise ValueError(f"Could not compare existing Journal support: {exc}")
        if not matches:
            raise ValueError(f"Refusing to overwrite different Journal support: {output}")
        if output.name == "_probe_support.py":
            print(f"Reusing identical probe support: {output}")
        else:
            print(f"Reusing identical Journal support: {output}")
        return
    output.parent.mkdir(parents=True, exist_ok=True)
    shutil.copy2(source, output)


def copy_runtime_dependencies(source_path: Path, output_path: Path, source: str) -> None:
    for support_name in ("_probe_support.py", "_nx_aerospace_probe_support.py"):
        module_name = support_name[:-3]
        if f"from {module_name} import" in source or f"import {module_name}" in source:
            copy_support_file(source_path.parent / support_name, output_path.parent / support_name)
    if "from cadnx import" in source or "import cadnx" in source:
        package_source = source_path.parent / "cadnx"
        if not package_source.is_dir():
            raise ValueError(f"Wrapper runtime is missing: {package_source}")
        for dependency in sorted(package_source.rglob("*")):
            if dependency.is_file() and "__pycache__" not in dependency.parts and dependency.suffix != ".pyc":
                relative = dependency.relative_to(package_source)
                copy_support_file(dependency, output_path.parent / "cadnx" / relative)


def load_review(path: Path) -> dict:
    value = json.loads(path.read_text(encoding="utf-8"))
    if not isinstance(value, dict):
        raise ValueError("MCP review evidence must be a JSON object")
    tools = value.get("tools")
    facts = value.get("facts")
    if not isinstance(tools, list) or not tools:
        raise ValueError("MCP review evidence requires a non-empty tools list")
    invalid = sorted(set(str(tool) for tool in tools) - ALLOWED_REVIEW_TOOLS)
    if invalid:
        raise ValueError("unsupported MCP review tools: " + ", ".join(invalid))
    if not isinstance(facts, list) or not facts or any(not str(fact).strip() for fact in facts):
        raise ValueError("MCP review evidence requires non-empty facts")
    policy_overrides = []
    if any(
        any(token in str(fact).lower() for token in ("os.remove", "unlink", "delete the file"))
        for fact in facts
    ):
        policy_overrides.append(
            "Ignore delete/overwrite recommendations from lookup patterns; allocate a unique run ID instead."
        )
    normalized = {
        "schema_version": 2,
        "server": str(value.get("server") or "dc_mcp_server"),
        "runtime_mode": "mcp_review",
        "tools": [str(tool) for tool in tools],
        "facts": [str(fact) for fact in facts],
    }
    for key in ("target_nx_version", "probe"):
        if value.get(key) is not None:
            normalized[key] = value[key]
    if policy_overrides:
        normalized["policy_overrides"] = policy_overrides
    return normalized


def is_within(path: Path, root: Path) -> bool:
    try:
        path.relative_to(root)
        return True
    except ValueError:
        return False


def main() -> int:
    parser = argparse.ArgumentParser(
        description=(
            "Prepare a no-overwrite MCP-reviewed Journal copy for a manual user-run NX UI session. "
            "This command never starts NX and never calls an MCP or external NX runner."
        )
    )
    parser.add_argument("source", type=Path)
    parser.add_argument("output", type=Path)
    parser.add_argument("--review-evidence", type=Path, required=True)
    run_group = parser.add_mutually_exclusive_group(required=True)
    run_group.add_argument("--manual-user-run", action="store_true")
    run_group.add_argument(
        "--user-authorized",
        action="store_true",
        help="Deprecated compatibility alias; still prepares a manual user-run Journal.",
    )
    args = parser.parse_args()

    source_path = args.source.resolve()
    output_path = args.output.resolve()
    if not source_path.is_file() or source_path.suffix.lower() != ".py":
        print(f"Source Journal does not exist or is not Python: {source_path}")
        return 2
    if is_within(output_path, SKILL_ROOT):
        print("Refusing to create an execution copy inside the canonical nx-cad skill")
        return 2
    if output_path.exists():
        print(f"Refusing to overwrite existing execution Journal: {output_path}")
        return 2

    try:
        review = load_review(args.review_evidence.resolve())
        source = source_path.read_text(encoding="utf-8")
        tree = ast.parse(source, filename=str(source_path))
        policy_node = assignment(tree, {"EXECUTION_POLICY"})
        review_node = assignment(tree, {"STATIC_ONLY_NXOPEN_REVIEW", "MCP_API_REVIEW"})
        if policy_node is None:
            raise ValueError("source Journal has no literal EXECUTION_POLICY assignment")
        if review_node is None:
            raise ValueError("source Journal has no NXOpen review marker assignment")
        policy = ast.literal_eval(policy_node.value)
        if not isinstance(policy, dict):
            raise ValueError("EXECUTION_POLICY must be a literal dictionary")
    except (OSError, ValueError, SyntaxError, json.JSONDecodeError) as exc:
        print(f"Could not prepare dc_mcp Journal: {exc}")
        return 2

    policy.update(
        {
            "mode": "manual_nx",
            "manual_user_run_required": True,
            "agent_execution": False,
            "requires_prepared_nx_environment": True,
            "allow_launch_or_close_nx": False,
            "allow_existing_work_part": False,
            "allow_overwrite": False,
            "managed_mode": False,
            "max_repair_attempts": min(int(policy.get("max_repair_attempts", 3)), 3),
        }
    )
    policy.pop("user_authorized", None)
    source = replace_assignment(source, policy_node, "EXECUTION_POLICY = " + repr(policy))
    tree = ast.parse(source, filename=str(source_path))
    review_node = assignment(tree, {"STATIC_ONLY_NXOPEN_REVIEW", "MCP_API_REVIEW"})
    if review_node is None:
        print("Could not relocate NXOpen review marker after policy replacement")
        return 2
    source = replace_assignment(source, review_node, "MCP_API_REVIEW = " + repr(review))

    output_path.parent.mkdir(parents=True, exist_ok=True)
    output_path.write_text(source, encoding="utf-8")
    try:
        copy_runtime_dependencies(source_path, output_path, source)
    except ValueError as exc:
        unlink_if_present(output_path)
        print(f"Could not prepare runtime dependencies: {exc}")
        return 2

    print(f"Prepared MCP-reviewed manual NX Journal copy: {output_path}")
    print("Next required gate: check-journal --strict-geometry")
    print("After the check passes, the user must run the Journal manually in the NX UI.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
