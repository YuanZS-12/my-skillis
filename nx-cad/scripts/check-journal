    "build123d",
    "cadquery",
    "cqkit",
    "OCP",
    "OCC",
    "FreeCAD",
    "openscad",
}

ROTATING_BLADE_TERMS = ("impeller", "propeller", "turbine", "blisk", "fan", "compressor")
ADVANCED_GEOMETRY_TERMS = (
    "revolved_profile",
    "lofted_blade",
    "swept_blade",
    "airfoil_section",
    "blade_station",
    "twist_degrees",
)
PRIMITIVE_BLADE_TERMS = ("polygon_prism", "oriented_box", "box(")
EXTERNAL_COMPONENT_TERMS = (
    r"\bmotor\b",
    r"\bservo\b",
    r"\belectrical connector\b",
    r"\bactuator\b",
    r"\belectronics board\b",
    r"\bstandoff\b",
    r"\bnema\s*\d*",
    r"\b608(?:zz|rs)?\b",
)
SIMPLIFIED_ENVELOPE_TERMS = ("b.cylinder", "b.box", "rounded_box", "simplified envelope", "envelope")
RAW_NXOPEN_ALLOWED_REVIEW_MARKERS = ("MCP_API_REVIEW", "STATIC_ONLY_NXOPEN_REVIEW")
MCP_REVIEW_TOOLS = {
    "dc_lookup_pattern",
    "dc_search",
    "dc_semantic_search",
