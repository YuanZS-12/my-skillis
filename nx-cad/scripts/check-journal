    "launch Siemens NX",
)
HARDCODED_ABSOLUTE_PATH_PATTERNS = (
    r"/Users/[A-Za-z0-9_.-]+/",
    r"/home/[A-Za-z0-9_.-]+/",
    r"[A-Za-z]:\\\\",
    r"[A-Za-z]:/",
)


def repo_root() -> Path:
    return Path(__file__).resolve().parents[3]


def compile_file(path: Path) -> list[str]:
    try:
        compile(path.read_text(encoding="utf-8"), str(path), "exec")
    except SyntaxError as exc:
        return [f"{path}: syntax error line {exc.lineno}: {exc.msg}"]
    return []


def import_root(name: str) -> str:
    return name.split(".", 1)[0]


def imports_raw_nxopen(tree: ast.AST) -> bool:
    for node in ast.walk(tree):
        if isinstance(node, ast.Import):
            for alias in node.names:
                if alias.name == "NXOpen" or alias.name.startswith("NXOpen."):
                    return True
        elif isinstance(node, ast.ImportFrom) and node.module and node.module.startswith("NXOpen"):
            return True
    return False


def uses_nxbuilder(source: str) -> bool:
    return (
        "from cadnx import NXBuilder" in source
        or "cadnx.NXBuilder" in source
        or re.search(r"\bNXBuilder\s*\(", source) is not None
    )


def journal_requires_runtime(source: str) -> bool:
    return uses_nxbuilder(source) or "from cadnx import" in source or "import cadnx" in source


def is_low_fidelity_fallback(source: str) -> bool:
    return "LOW_FIDELITY_FALLBACK" in source


def is_raw_nxopen_high_fidelity(source: str) -> bool:
    return RAW_NXOPEN_HIGH_FIDELITY_MARKER in source


def has_hardcoded_absolute_path(source: str) -> bool:
    return any(re.search(pattern, source) for pattern in HARDCODED_ABSOLUTE_PATH_PATTERNS)


def call_attr_name(node: ast.Call) -> str | None:
    if isinstance(node.func, ast.Attribute):
        return node.func.attr
    return None


def static_float(node: ast.AST) -> float | None:
    if isinstance(node, ast.Constant) and isinstance(node.value, (int, float)):
        return float(node.value)
    if isinstance(node, ast.UnaryOp) and isinstance(node.op, ast.USub):
        value = static_float(node.operand)
        return -value if value is not None else None
    if isinstance(node, ast.UnaryOp) and isinstance(node.op, ast.UAdd):
        return static_float(node.operand)
    return None


def static_vector(node: ast.AST) -> tuple[float | None, float | None, float | None] | None:
    if not isinstance(node, (ast.Tuple, ast.List)) or len(node.elts) != 3:
        return None
    return tuple(static_float(elt) for elt in node.elts)


def is_axis_aligned_static_vector(vector: tuple[float | None, float | None, float | None]) -> bool:
    known_nonzero = 0
    known_zero = 0
    unknown = 0
    for value in vector:
        if value is None:
            unknown += 1
        elif abs(value) <= 1e-9:
            known_zero += 1
        else:
            known_nonzero += 1

    if unknown:
        return known_nonzero <= 1 and known_zero >= 2
    return known_nonzero == 1


def slot_cut_vector_arg(node: ast.Call, name: str, position: int) -> ast.AST | None:
    for keyword in node.keywords:
        if keyword.arg == name:
            return keyword.value
    if len(node.args) > position:
        return node.args[position]
    return None


def validate_slot_cut_axes(path: Path, tree: ast.AST) -> list[str]:
    problems: list[str] = []
    for node in ast.walk(tree):
        if not isinstance(node, ast.Call) or call_attr_name(node) != "slot_cut":
            continue
        for name, position in (("axis", 5), ("direction", 6)):
            arg = slot_cut_vector_arg(node, name, position)
            if arg is None:
                continue
            vector = static_vector(arg)
            if vector is not None and not is_axis_aligned_static_vector(vector):
                problems.append(
                    f"{path}: slot_cut {name} must be axis-aligned; use rectangular_pocket/box cutters "
                    "for angled cosmetic marks or extend NXBuilder before generating angled slots"
                )
    return problems


def validate_boolean_overlap_budget(path: Path, tree: ast.AST, source: str) -> list[str]:
    problems: list[str] = []
    calls_unite = False
    calls_subtract = False

    for node in ast.walk(tree):
        if not isinstance(node, ast.Call):
            continue
        attr = call_attr_name(node)
        name = attr or (node.func.id if isinstance(node.func, ast.Name) else None)
        if name in {"boolean_unite", "unite", "safe_unite"}:
            calls_unite = True
        elif name in {"boolean_subtract", "subtract", "safe_subtract"}:
            calls_subtract = True

    if calls_unite and "feature_overlap" not in source:
        problems.append(
            f"{path}: boolean_unite calls require a named feature_overlap so united bodies have real volume overlap"
        )
    if calls_subtract and "cutter_overlap" not in source and "through_overcut" not in source:
        problems.append(
            f"{path}: boolean_subtract calls require a named cutter_overlap or through_overcut so cutters do not merely touch target faces"
        )

    return problems


def call_count(tree: ast.AST, names: set[str]) -> int:
    count = 0
    for node in ast.walk(tree):
        if isinstance(node, ast.Call) and call_attr_name(node) in names:
            count += 1
    return count


def has_call(tree: ast.AST, name: str) -> bool:
    return call_count(tree, {name}) > 0


def has_boolean_inside_loop(tree: ast.AST) -> bool:
    for node in ast.walk(tree):
        if not isinstance(node, (ast.For, ast.While)):
            continue
        for child in ast.walk(node):
            if isinstance(child, ast.Call) and call_attr_name(child) in {"boolean_unite", "boolean_subtract"}:
                return True
    return False


def has_global_axis_fillet(tree: ast.AST) -> bool:
    for node in ast.walk(tree):
        if not isinstance(node, ast.Call) or call_attr_name(node) != "fillet":
            continue
        if not node.args:
            continue
        selector = node.args[0]
        if isinstance(selector, ast.Call) and call_attr_name(selector) in {"get_all_edges", "get_edges_by_axis"}:
            return True
    return False


def validate_feature_budget(
    path: Path,
    tree: ast.AST,
    source: str,
    *,
    raw_nxopen: bool,
) -> list[str]:
    if is_low_fidelity_fallback(source):
        return []

    problems: list[str] = []
    lower_source = source.lower()
    looks_like_aerospace_frame = any(
        token in lower_source
        for token in ("aerospace", "turbofan", "hpc", "rear frame", "strut_count", "diffuser")
    )
    complex_static_count = call_count(tree, {"boolean_unite", "boolean_subtract", "hole"}) >= 24
    patterned_booleans = has_boolean_inside_loop(tree)
    requires_budget = looks_like_aerospace_frame or complex_static_count or patterned_booleans
    if requires_budget:
        if raw_nxopen and '"feature_budget"' not in source and "'feature_budget'" not in source:
            problems.append(
                f"{path}: complex raw aerospace/frame journals require DESIGN_LEDGER "
                "feature_budget with boolean_operations, micro_holes, and patterned_features"
            )
        elif not raw_nxopen and not has_call(tree, "require_feature_budget"):
            problems.append(
                f"{path}: complex aerospace/frame journals require b.require_feature_budget(...) "
                "with boolean_operations, micro_holes, and patterned_features budgets"
            )
    if (looks_like_aerospace_frame or patterned_booleans) and has_global_axis_fillet(tree):
        problems.append(
            f"{path}: avoid global fillet after high-pattern boolean features; use local edge selectors "
            "such as get_edges_in_box(...) or targeted chamfers"
        )
    return problems


def validate_linkage_semantics(
    path: Path,
    tree: ast.AST,
    source: str,
    *,
    raw_nxopen: bool,
) -> list[str]:
    lower_source = source.lower()
    lower_name = path.name.lower()
    looks_like_linkage = any(
        token in lower_source or token in lower_name
        for token in ("bellcrank", "flight_control", "flight control", "clevis", "control arm", "linkage")
    )
    if not looks_like_linkage:
        return []

    semantic_helpers = {"bearing_seat", "bushing_boss", "clevis"}
    if raw_nxopen:
        problems: list[str] = []
        if "DESIGN_LEDGER" not in source:
            problems.append(
                f"{path}: raw aerospace linkage/bellcrank journals require a DESIGN_LEDGER "
                "with critical native feature intent and expected body count"
            )
        if not any(term in lower_source for term in semantic_helpers):
            problems.append(
                f"{path}: raw aerospace linkage/bellcrank journals require native bearing-seat, "
                "bushing-boss, or clevis feature intent in the design ledger/source"
            )
        return problems

    if not any(has_call(tree, helper) for helper in semantic_helpers):
        return [
            f"{path}: aerospace linkage/bellcrank journals require semantic helpers "
            "such as b.bearing_seat(...), b.bushing_boss(...), or b.clevis(...)"
        ]
    return []


def parent_map(tree: ast.AST) -> dict[ast.AST, ast.AST]:
    return {child: node for node in ast.walk(tree) for child in ast.iter_child_nodes(node)}


def assigned_factory(node: ast.AST) -> tuple[str, str] | None:
    if not isinstance(node, (ast.Assign, ast.AnnAssign)):
        return None
    value = node.value
    if not isinstance(value, ast.Call) or not isinstance(value.func, ast.Attribute):
        return None
    factory = value.func.attr
    if not (factory.startswith("Create") and (factory.endswith("Builder") or factory.endswith("Creator"))):
        return None
    target = node.targets[0] if isinstance(node, ast.Assign) and node.targets else node.target
    if isinstance(target, ast.Name):
        return target.id, factory
    return None


def destroys_name(nodes: list[ast.stmt], name: str) -> bool:
    for node in nodes:
        for child in ast.walk(node):
            if not isinstance(child, ast.Call) or not isinstance(child.func, ast.Attribute):
                continue
            if child.func.attr != "Destroy":
                continue
            if isinstance(child.func.value, ast.Name) and child.func.value.id == name:
                return True
    return False


def validate_raw_builder_lifecycle(path: Path, tree: ast.AST) -> list[str]:
    parents = parent_map(tree)
    problems: list[str] = []
    for node in ast.walk(tree):
        assigned = assigned_factory(node)
        if assigned is None:
            continue
        name, factory = assigned
        current = parents.get(node)
        protected = False
        while current is not None:
            if isinstance(current, ast.Try) and destroys_name(current.finalbody, name):
                protected = True
                break
            body = getattr(current, "body", None)
            if isinstance(body, list) and node in body:
                node_index = body.index(node)
                for following in body[node_index + 1 :]:
                    if isinstance(following, ast.Try) and destroys_name(following.finalbody, name):
                        protected = True
                        break
                if protected:
                    break
            current = parents.get(current)
        if not protected:
            problems.append(
                f"{path}: {factory} assigned to {name!r} must be protected by try/finally "
                "that calls Destroy(), so commit failures cannot leak NX objects"
            )
    return problems


def validate_silent_critical_failures(path: Path, tree: ast.AST) -> list[str]:
    problems: list[str] = []
    critical_names = {"safe_unite", "safe_subtract", "safe_boolean", "safe_loft", "safe_sweep"}
    for node in ast.walk(tree):
        if not isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)) or node.name not in critical_names:
            continue
        for handler in (child for child in ast.walk(node) if isinstance(child, ast.ExceptHandler)):
            if any(isinstance(child, ast.Return) for child in ast.walk(handler)):
                problems.append(
                    f"{path}: {node.name} catches a critical geometry failure and returns; "
                    "primary/functional unite, subtract, loft, and sweep failures must stop the journal"
                )
                break
    return problems


def validate_smooth_section_fidelity(path: Path, tree: ast.AST, source: str) -> list[str]:
    lower = source.lower()
    if is_low_fidelity_fallback(source):
        return []
    claims_smooth_section = any(term in lower for term in ("ellipse", "airfoil", "smooth section", "smooth profile"))
    functions = {
        node.name: node
        for node in ast.walk(tree)
        if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef))
    }
    reachable = {"main"}
    pending = ["main"]
    while pending:
        name = pending.pop()
        function = functions.get(name)
        if function is None:
            continue
        for call in (node for node in ast.walk(function) if isinstance(node, ast.Call)):
            if isinstance(call.func, ast.Name) and call.func.id in functions and call.func.id not in reachable:
                reachable.add(call.func.id)
                pending.append(call.func.id)
    reachable_nodes = [functions[name] for name in reachable if name in functions]
    creates_lines = any(
        isinstance(node, ast.Call) and call_attr_name(node) == "CreateLine"
        for function in reachable_nodes
        for node in ast.walk(function)
    )
    smooth_factories = {
        "CreateEllipse",
        "CreateStudioSplineBuilder",
        "CreateStudioSplineBuilderEx",
        "CreateSpline",
    }
    creates_smooth_curve = any(
        isinstance(node, ast.Call) and call_attr_name(node) in smooth_factories
        for function in reachable_nodes
        for node in ast.walk(function)
    ) or any(
        isinstance(node, ast.Assign)
        and any(isinstance(target, ast.Attribute) and target.attr == "IsPeriodic" for target in node.targets)
        for function in reachable_nodes
        for node in ast.walk(function)
    )
    if claims_smooth_section and creates_lines and not creates_smooth_curve:
        return [
            f"{path}: smooth ellipse/airfoil section is implemented only with line segments; "
            "use an analytic or closed spline section, or declare LOW_FIDELITY_FALLBACK"
        ]
    return []


def validate_unused_curve_helpers(path: Path, tree: ast.AST, source: str) -> list[str]:
    if not any(term in source.lower() for term in ("sweep", "guide", "spline", "loft")):
        return []
    defined = {
        node.name
        for node in ast.walk(tree)
        if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef))
        and any(term in node.name.lower() for term in ("guide", "spline"))
    }
    called = {
        node.func.id
        for node in ast.walk(tree)
        if isinstance(node, ast.Call) and isinstance(node.func, ast.Name)
    }
    unused = sorted(defined - called)
    if unused:
        return [
            f"{path}: curve/guide helpers are defined but unused ({', '.join(unused)}); "
            "do not claim guide-controlled geometry when the guide is absent from the committed feature"
        ]
    return []


def validate_controlled_nx_boundary(path: Path, tree: ast.AST, source: str) -> list[str]:
    for node in ast.walk(tree):
        if not isinstance(node, ast.Call):
            continue
        name = call_attr_name(node) or (node.func.id if isinstance(node.func, ast.Name) else None)
        if name == "dc_run_journal":
            return [
                f"{path}: generated journals must not recursively invoke dc_run_journal; "
                "NX execution is manual from the user-prepared NX UI"
            ]
    for term in FORBIDDEN_AGENT_NX_EXECUTION_TERMS:
        if term in source:
            return [
                f"{path}: generated journals must not launch NX directly ({term})"
            ]
    return []


def literal_assignment(tree: ast.AST, name: str) -> object | None:
    for node in tree.body if isinstance(tree, ast.Module) else []:
        if not isinstance(node, (ast.Assign, ast.AnnAssign)):
            continue
        targets = node.targets if isinstance(node, ast.Assign) else [node.target]
        if not any(isinstance(target, ast.Name) and target.id == name for target in targets):
            continue
        try:
            return ast.literal_eval(node.value)
        except (ValueError, TypeError):
            return None
    return None


def validate_execution_policy(path: Path, tree: ast.AST, source: str) -> list[str]:
    policy = literal_assignment(tree, "EXECUTION_POLICY")
    if policy is None:
        if "manual_nx" in source:
            return [f"{path}: manual_nx journals require a literal EXECUTION_POLICY"]
        return []
    if not isinstance(policy, dict):
        return [f"{path}: EXECUTION_POLICY must be a literal dictionary"]

    problems: list[str] = []
    mode = policy.get("mode")
    if mode not in {"static_only", "mcp_review", "manual_nx"}:
        problems.append(f"{path}: EXECUTION_POLICY mode must be static_only, mcp_review, or manual_nx")
    if policy.get("allow_launch_or_close_nx") is not False and "allow_launch_or_close_nx" in policy:
        problems.append(f"{path}: EXECUTION_POLICY must set allow_launch_or_close_nx=false")
    if policy.get("allow_overwrite") is not False:
        problems.append(f"{path}: EXECUTION_POLICY must set allow_overwrite=false")
    if policy.get("allow_existing_work_part") is not False and "allow_existing_work_part" in policy:
        problems.append(f"{path}: generated-part execution must set allow_existing_work_part=false")
    if policy.get("managed_mode") is not False and "managed_mode" in policy:
        problems.append(f"{path}: initial controlled execution requires managed_mode=false")
    attempts = policy.get("max_repair_attempts")
    if not isinstance(attempts, int) or isinstance(attempts, bool) or not 0 <= attempts <= 3:
        problems.append(f"{path}: max_repair_attempts must be an integer from 0 through 3")
    if policy.get("agent_execution") is not False:
        problems.append(f"{path}: EXECUTION_POLICY must set agent_execution=false")
    if uses_nxbuilder(source) and policy.get("allow_existing_work_part") is False:
        builder_calls = [
            node
            for node in ast.walk(tree)
            if isinstance(node, ast.Call)
            and (
                (isinstance(node.func, ast.Name) and node.func.id == "NXBuilder")
                or (isinstance(node.func, ast.Attribute) and node.func.attr == "NXBuilder")
            )
        ]
        for call in builder_calls:
            keywords = {keyword.arg: keyword.value for keyword in call.keywords if keyword.arg}
            if "part_path" not in keywords:
                problems.append(
                    f"{path}: controlled NXBuilder execution requires an explicit part_path"
                )
            force_new = keywords.get("force_new_part")
            if force_new is None or (
                isinstance(force_new, ast.Constant) and force_new.value is not True
            ):
                problems.append(
                    f"{path}: allow_existing_work_part=false requires "
                    "NXBuilder(..., force_new_part=True) or an equivalent dynamic guard"
                )
    if mode == "manual_nx":
        if policy.get("manual_user_run_required") is not True:
            problems.append(f"{path}: manual_nx requires manual_user_run_required=true")
        if policy.get("requires_prepared_nx_environment") is not True:
            problems.append(f"{path}: manual_nx requires requires_prepared_nx_environment=true")
        if imports_raw_nxopen(tree):
            review = literal_assignment(tree, "MCP_API_REVIEW")
            if not isinstance(review, dict):
                problems.append(
                    f"{path}: raw NXOpen manual_nx requires a literal MCP_API_REVIEW; "
                    "STATIC_ONLY_NXOPEN_REVIEW is not API review evidence"
                )
            else:
                tools = review.get("tools")
                facts = review.get("facts")
                if not isinstance(tools, list) or not tools:
                    problems.append(
                        f"{path}: raw NXOpen manual_nx MCP_API_REVIEW requires a non-empty tools list"
                    )
                else:
                    invalid_tools = sorted(
                        {str(tool) for tool in tools if str(tool) not in MCP_REVIEW_TOOLS}
                    )
                    if invalid_tools:
                        problems.append(
                            f"{path}: MCP_API_REVIEW contains unsupported review tools: "
                            + ", ".join(invalid_tools)
                        )
                if (
                    not isinstance(facts, list)
                    or not facts
                    or any(not isinstance(fact, str) or not fact.strip() for fact in facts)
                ):
                    problems.append(
                        f"{path}: raw NXOpen manual_nx MCP_API_REVIEW requires non-empty facts"
                    )
    if "user_authorized" in policy:
        problems.append(f"{path}: user_authorized is obsolete; NX execution is always a manual user run")
    return problems


def validate_raw_completion_contract(path: Path, source: str) -> list[str]:
    problems: list[str] = []
    upper = source.upper()
    claims_complete = "COMPLETE" in upper or "NXCAD_RESULT: SUCCESS" in upper
    if claims_complete:
        if "DESIGN_LEDGER" not in source or "expected_body_count" not in source:
            problems.append(
                f"{path}: raw completion claims require DESIGN_LEDGER expected_body_count"
            )
        if "body_count" not in source or "raise RuntimeError" not in source:
            problems.append(
                f"{path}: raw completion claims require body-count validation that raises on mismatch"
            )
    uses_step_creator = any(token in source for token in STEP_CREATOR_TERMS)
    waits_for_step = "os.path.exists" in source and "range(" in source
    if uses_step_creator and waits_for_step:
        has_explicit_failure = (
            "STEP export timed out" in source
            or "STEP export did not create" in source
            or "non-empty output file" in source
        ) and "raise RuntimeError" in source
        if not has_explicit_failure:
            problems.append(
                f"{path}: STEP polling loop must raise an explicit failure when no non-empty file appears"
            )
    return problems


def validate_rotating_blade_quality(path: Path, source: str) -> list[str]:
    lower_source = source.lower()
    lower_name = path.name.lower()
    looks_like_rotating_blade = any(
        token in lower_source or token in lower_name for token in ROTATING_BLADE_TERMS
    )
    claims_high_precision = "high_precision" in lower_name or "high_precision" in lower_source or "high precision" in lower_source
    has_blade_pattern = "blade_count" in lower_source
    uses_primitive_blades = any(token in lower_source for token in PRIMITIVE_BLADE_TERMS)
    uses_advanced_geometry = any(token in lower_source for token in ADVANCED_GEOMETRY_TERMS)

    if (
        looks_like_rotating_blade
        and claims_high_precision
        and has_blade_pattern
        and uses_primitive_blades
        and not uses_advanced_geometry
    ):
        return [
            f"{path}: primitive-only high-precision rotating blade model: use revolved "
            "hub/backplate plus named blade stations, airfoil sections, sweep/loft helpers, "
            "or explicitly downgrade the approximation"
        ]
    return []


def validate_external_component_ledger(path: Path, source: str) -> list[str]:
    lower_source = source.lower()
    mentions_external_component = any(re.search(pattern, lower_source) for pattern in EXTERNAL_COMPONENT_TERMS)
    uses_simplified_envelope = any(term in lower_source for term in SIMPLIFIED_ENVELOPE_TERMS)
    has_ledger = "external component ledger:" in lower_source

    if mentions_external_component and uses_simplified_envelope and not has_ledger:
        return [
            f"{path}: named external components require an external component ledger "
            "before using simplified envelope geometry"
        ]
    return []


def validate_raw_nxopen_review_markers(path: Path, tree: ast.AST, source: str) -> list[str]:
    if not imports_raw_nxopen(tree):
        return []
    if any(marker in source for marker in RAW_NXOPEN_ALLOWED_REVIEW_MARKERS):
        return []
    return [
        f"{path}: raw NXOpen journals require MCP_API_REVIEW evidence or STATIC_ONLY_NXOPEN_REVIEW"
    ]


def validate_raw_nxopen_diagnostics(path: Path, tree: ast.AST, source: str) -> list[str]:
    if not imports_raw_nxopen(tree):
        return []
    problems: list[str] = []
    uses_parts_work = any(
        isinstance(node, ast.Attribute)
        and node.attr == "Work"
        and isinstance(node.value, ast.Attribute)
        and node.value.attr == "Parts"
        for node in ast.walk(tree)
    )
    if "create_work_part_if_needed" not in source and uses_parts_work:
        problems.append(f"{path}: raw NXOpen journals should guard missing work parts with create_work_part_if_needed")
    if "print(" not in source:
        problems.append(f"{path}: raw NXOpen journals should print runtime diagnostics for part/body/export state")
    uses_raw_builder_factory = any(token in source for token in RAW_ADVANCED_NXOPEN_TERMS) or re.search(
        r"\.Create[A-Za-z0-9_]*Builder\(",
        source,
    )
    if ".Destroy()" not in source and uses_raw_builder_factory:
        problems.append(f"{path}: raw NXOpen builder journals should destroy builders after commit or probe")
    uses_step_creator = any(token in source for token in STEP_CREATOR_TERMS)
    if uses_step_creator and ".Destroy()" not in source:
        problems.append(f"{path}: raw NXOpen STEP exporter journals should destroy STEP creators in a finally block")
    if uses_step_creator and "__file__" not in source:
        problems.append(f"{path}: raw NXOpen STEP exporter output paths should derive from __file__")
    uses_new_display = any(
        isinstance(node, ast.Call) and call_attr_name(node) == "NewDisplay"
        for node in ast.walk(tree)
    )
    if uses_new_display and ".Dispose()" not in source and "safe_dispose(" not in source:
        problems.append(f"{path}: raw NXOpen work-part creation should dispose load/status objects when present")
    if "CreatePmi" in source and "NXOpen.Annotations" not in source:
        problems.append(f"{path}: raw NXOpen PMI journals should explicitly import NXOpen.Annotations")
    return problems


def validate_raw_nxopen_high_fidelity_mode(path: Path, source: str, wrapper_assisted: bool) -> list[str]:
    if not is_raw_nxopen_high_fidelity(source):
        return []

    problems: list[str] = []
    if "import NXOpen" not in source and "from NXOpen" not in source:
        problems.append(f"{path}: RAW_NXOPEN_HIGH_FIDELITY journals must import NXOpen directly")
    if wrapper_assisted or "from cadnx import" in source or "import cadnx" in source:
        problems.append(
            f"{path}: RAW_NXOPEN_HIGH_FIDELITY journals must use direct NXOpen APIs, not cadnx.NXBuilder"
        )
    if not any(marker in source for marker in RAW_NXOPEN_ALLOWED_REVIEW_MARKERS):
        problems.append(
            f"{path}: RAW_NXOPEN_HIGH_FIDELITY journals require MCP_API_REVIEW or STATIC_ONLY_NXOPEN_REVIEW"
        )
    return problems


def validate_misleading_primitive_approximation(path: Path, tree: ast.AST, source: str) -> list[str]:
    lower = (path.name + "\n" + source).lower()
    if is_low_fidelity_fallback(source):
        return []
    looks_smooth = any(term in lower for term in SMOOTH_HIGH_FIDELITY_TERMS)
    primitive_count = sum(
        source.count(token)
        for token in ("polygon_prism_on_plane", "polygon_prism", ".box(", ".oriented_box(", ".cylinder(")
    )
    uses_advanced_geometry = any(token in source for token in RAW_ADVANCED_NXOPEN_TERMS) or any(
        token in lower for token in ("lofted_blade", "swept_blade", "airfoil_section")
    )
    if looks_smooth and primitive_count >= 2 and not uses_advanced_geometry:
        return [
            f"{path}: misleading primitive approximation; document LOW_FIDELITY_FALLBACK or use raw NXOpen advanced geometry"
        ]
    return []


def validate_journal(path: Path, *, strict_geometry: bool = False) -> list[str]:
    problems = compile_file(path)
    if problems:
        return problems

    source = path.read_text(encoding="utf-8")
    tree = ast.parse(source, filename=str(path))
    has_build = False
    has_main = False
    imports_nxbuilder = False
    calls_export_step = False
    raw_nxopen = imports_raw_nxopen(tree)

    for node in ast.walk(tree):
        if isinstance(node, ast.FunctionDef) and node.name == "build":
            has_build = True
        elif isinstance(node, ast.FunctionDef) and node.name == "main":
            has_main = True
        elif isinstance(node, ast.Call):
            func = node.func
            if isinstance(func, ast.Attribute) and func.attr == "export_step":
                calls_export_step = True
        elif isinstance(node, ast.Import):
            for alias in node.names:
                root = import_root(alias.name)
                if root in FORBIDDEN_IMPORTS:
                    problems.append(f"{path}: forbidden CAD kernel import: {alias.name}")
        elif isinstance(node, ast.ImportFrom):
            module = node.module or ""
            root = import_root(module)
            if root in FORBIDDEN_IMPORTS:
                problems.append(f"{path}: forbidden CAD kernel import: {module}")
            if module == "cadnx" and any(alias.name == "NXBuilder" for alias in node.names):
                imports_nxbuilder = True

    wrapper_assisted = imports_nxbuilder or uses_nxbuilder(source)

    if wrapper_assisted and not has_build:
        problems.append(f"{path}: missing required build(output_path: str = None)")
    if not has_main:
        problems.append(f"{path}: missing required main() entry point")
    if wrapper_assisted and not imports_nxbuilder:
        problems.append(f"{path}: expected `from cadnx import NXBuilder`")
    if wrapper_assisted and not calls_export_step:
        problems.append(f"{path}: expected a call to NXBuilder.export_step(output_path)")
    if has_hardcoded_absolute_path(source) or "copilot-cad-test" in source:
        problems.append(
            f"{path}: generated journal must not hardcode local Mac workspace paths "
            "or other local machine workspace paths"
        )
    problems.extend(validate_slot_cut_axes(path, tree))
    if raw_nxopen:
        problems.extend(validate_raw_nxopen_review_markers(path, tree, source))
        problems.extend(validate_raw_nxopen_diagnostics(path, tree, source))
        problems.extend(validate_raw_builder_lifecycle(path, tree))
        problems.extend(validate_silent_critical_failures(path, tree))
        problems.extend(validate_controlled_nx_boundary(path, tree, source))
        problems.extend(validate_raw_completion_contract(path, source))
    problems.extend(validate_execution_policy(path, tree, source))
    problems.extend(validate_raw_nxopen_high_fidelity_mode(path, source, wrapper_assisted))
    if strict_geometry:
        problems.extend(validate_boolean_overlap_budget(path, tree, source))
        problems.extend(validate_feature_budget(path, tree, source, raw_nxopen=raw_nxopen))
        problems.extend(validate_linkage_semantics(path, tree, source, raw_nxopen=raw_nxopen))
        problems.extend(validate_rotating_blade_quality(path, source))
        problems.extend(validate_external_component_ledger(path, source))
        problems.extend(validate_misleading_primitive_approximation(path, tree, source))
        if raw_nxopen:
            problems.extend(validate_smooth_section_fidelity(path, tree, source))
            problems.extend(validate_unused_curve_helpers(path, tree, source))

    return problems


def runtime_files(models_dir: Path) -> list[Path]:
    runtime = models_dir / "cadnx"
    return [runtime / "__init__.py", runtime / "builder.py"]


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Statically check a generated nx-cad journal and its local runtime."
    )
    parser.add_argument("journal", type=Path, help="Generated NXOpen Python journal.")
    parser.add_argument(
        "--models-dir",
        type=Path,
        help="Directory containing cadnx/. Defaults to the journal parent.",
    )
    parser.add_argument(
        "--strict-geometry",
        action="store_true",
        help=(
            "Reject generated journals that use boolean operations without named "
            "overlap/overcut budget parameters."
        ),
    )
    args = parser.parse_args()

    journal = args.journal.resolve()
    if not journal.is_file():
        print(f"ERROR: journal not found: {journal}")
        return 2

    models_dir = (args.models_dir.resolve() if args.models_dir else journal.parent)
    problems = validate_journal(journal, strict_geometry=args.strict_geometry)

    source = journal.read_text(encoding="utf-8")
    if journal_requires_runtime(source):
        for runtime_file in runtime_files(models_dir):
            if not runtime_file.is_file():
                problems.append(f"missing runtime file: {runtime_file}")
            else:
                problems.extend(compile_file(runtime_file))

    if problems:
        print("nx-cad journal check failed:")
        for problem in problems:
            print(f"  {problem}")
        return 1

    print(f"nx-cad journal check passed: {journal}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
