#!/usr/bin/env python3
"""Audit local source contracts for nx-cad/dc_mcp_server integration."""

from __future__ import annotations

import json
import os
from pathlib import Path


SKILL_ROOT = Path(__file__).resolve().parents[1]
REPO_ROOT = SKILL_ROOT.parents[1]


def require_text(path: Path, tokens: tuple[str, ...], problems: list[str]) -> None:
    if not path.is_file():
        problems.append(f"missing required file: {path}")
        return
    text = path.read_text(encoding="utf-8")
    for token in tokens:
        if token not in text:
            problems.append(f"{path}: missing integration contract token {token!r}")


def main() -> int:
    problems: list[str] = []
    require_text(
        SKILL_ROOT / "SKILL.md",
        ("`static_only`", "`mcp_review`", "`mcp_execute`", "dc_run_journal", "Never launch or close"),
        problems,
    )
    require_text(
        SKILL_ROOT / "references" / "mcp-runtime.md",
        (
            "dc_lookup_pattern",
            "dc_search",
            "dc_semantic_search",
            "dc_get_api_info",
            "dc_list_namespace",
            "dc_run_snippet",
            "dc_run_journal",
            "journal_path: absolute .py/.vb/.cs path",
            "max_repair_attempts",
        ),
        problems,
    )
    for template in (
        SKILL_ROOT / "templates" / "nxopen_part_template.py",
        SKILL_ROOT / "templates" / "raw_nxopen_part_template.py",
    ):
        require_text(
            template,
            (
                "EXECUTION_POLICY",
                '"schema_version": 2',
                '"allow_overwrite": False',
                '"max_repair_attempts": 3',
                "allocate_run_context",
                '"critical_features"',
            ),
            problems,
        )

    try:
        schema = json.loads((SKILL_ROOT / "runtime-results" / "schema.json").read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        problems.append(f"invalid runtime schema: {exc}")
        schema = {}
    if schema.get("properties", {}).get("schema_version", {}).get("enum") != [1, 2]:
        problems.append("runtime schema must accept versions 1 and 2")
    if "execution" not in schema.get("properties", {}):
        problems.append("runtime schema must define execution provenance")

    for script_name in (
        "prepare-dc-mcp-journal",
        "parse-dc-mcp-result",
        "check-mcp-repair-state",
        "check-runtime-report",
    ):
        script = SKILL_ROOT / "scripts" / script_name
        if not script.is_file() or not os.access(script, os.X_OK):
            problems.append(f"required integration script is missing or not executable: {script}")
    if (SKILL_ROOT / "scripts" / "nx-run.bat").exists():
        problems.append("shell/batch NX launcher must not exist")
    require_text(
        SKILL_ROOT / "scripts" / "check-journal",
        (
            "raw NXOpen mcp_execute requires a literal MCP_API_REVIEW",
            "STATIC_ONLY_NXOPEN_REVIEW is not execution evidence",
            "MCP_REVIEW_TOOLS",
        ),
        problems,
    )

    fixture_root = REPO_ROOT / "tests" / "fixtures" / "nx-cad" / "dc-mcp"
    for name in (
        "lookup-pattern.md",
        "search.md",
        "semantic-search.md",
        "api-info.md",
        "namespace.md",
        "snippet-success.md",
        "journal-success.md",
        "journal-failure.md",
    ):
        if not (fixture_root / name).is_file():
            problems.append(f"missing dc_mcp Markdown fixture: {name}")

    manifest = SKILL_ROOT / "assets" / "runtime-probes" / "dc-mcp-integration-manifest.json"
    try:
        manifest_data = json.loads(manifest.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        problems.append(f"invalid dc_mcp integration manifest: {exc}")
        manifest_data = {}
    if manifest_data.get("allow_overwrite") is not False:
        problems.append("integration manifest must set allow_overwrite=false")
    if manifest_data.get("max_repair_attempts") != 3:
        problems.append("integration manifest must cap repairs at three")
    preparation = manifest_data.get("journal_preparation", {})
    if not isinstance(preparation, dict) or not preparation.get("windows_command"):
        problems.append("integration manifest must provide a Windows preparation command")
    if "byte-identical" not in str(preparation.get("shared_support", "")):
        problems.append("integration manifest must document safe shared probe support reuse")
    if manifest_data.get("deferred_initial_runs") != [
        "nx2606/07_sweep_angular_law.py",
        "nx2606/10_step_ap242.py",
    ]:
        problems.append("initial MCP integration must defer unstable probes 07 and 10")

    if problems:
        print("nx-cad dc_mcp integration audit failed:")
        for problem in problems:
            print(" ", problem)
        return 1
    print("nx-cad dc_mcp local integration audit passed")
    print("NX-machine dc_* discovery and runtime evidence remain external gates.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
